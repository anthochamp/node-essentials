{
	"name": "@ac-kit/app-terminal",
	"version": "0.1.0",
	"description": "The Terminal descriptor a rendering sink needs — interactivity, dimensions, colour depth, resize events, alt-screen support — injected rather than read from process.stdout.",
	"keywords": [
		"ansi",
		"color-depth",
		"portable",
		"terminal",
		"tty"
	],
	"homepage": "https://anthochamp.github.io/node-essentials/api/app-terminal/",
	"bugs": {
		"url": "https://github.com/anthochamp/node-essentials/issues"
	},
	"license": "BSD-3-Clause",
	"author": "Anthony Champagne <dev@anthonychampagne.fr>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anthochamp/node-essentials.git",
		"directory": "packages/app-terminal"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"exports": {
			".": "./dist/index.js"
		},
		"access": "public"
	},
	"scripts": {
		"compile": "tsc -p ./tsconfig.build.json -outDir dist",
		"compile:check": "tsc -noEmit -p ./tsconfig.json",
		"clean": "rimraf dist",
		"build": "yarn clean && yarn compile",
		"test": "yarn run -T vitest run",
		"prepack": "yarn build"
	},
	"dependencies": {
		"@ac-kit/async": "workspace:^",
		"@ac-kit/format-ansi": "workspace:^",
		"@ac-kit/format-monospace": "workspace:^",
		"@ac-kit/math-color": "workspace:^",
		"@types/web": "catalog:"
	},
	"devDependencies": {
		"@ac-kit/tsconfig": "workspace:*",
		"@ac-kit/typedoc-config": "workspace:*",
		"@ac-kit/vitest-config": "workspace:*",
		"@typescript/native": "catalog:fixed",
		"rimraf": "catalog:fixed",
		"typedoc": "catalog:fixed",
		"typescript": "catalog:fixed"
	},
	"engines": {
		"node": ">=24"
	}
}
