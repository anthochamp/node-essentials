{
	"name": "@ac-kit/model-dataset",
	"version": "0.1.0",
	"description": "Self-describing tabular data: a DataFrame of named, typed columns, plus the vocabulary that says what each column means.",
	"keywords": [
		"dataframe",
		"dataset",
		"schema",
		"tabular"
	],
	"homepage": "https://anthochamp.github.io/node-essentials/api/model-dataset/",
	"bugs": {
		"url": "https://github.com/anthochamp/node-essentials/issues"
	},
	"license": "BSD-3-Clause",
	"author": "Anthony Champagne <dev@anthonychampagne.fr>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anthochamp/node-essentials.git",
		"directory": "packages/model-dataset"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"exports": {
			".": "./dist/index.js"
		},
		"access": "public"
	},
	"scripts": {
		"compile": "tsc -p ./tsconfig.build.json -outDir dist",
		"compile:check": "tsc -noEmit -p ./tsconfig.json",
		"clean": "rimraf dist",
		"build": "yarn clean && yarn compile",
		"test": "yarn run -T vitest run",
		"prepack": "yarn build"
	},
	"devDependencies": {
		"@ac-kit/tsconfig": "workspace:*",
		"@ac-kit/typedoc-config": "workspace:*",
		"@ac-kit/vitest-config": "workspace:*",
		"@typescript/native": "catalog:fixed",
		"rimraf": "catalog:fixed",
		"typedoc": "catalog:fixed",
		"typescript": "catalog:fixed"
	},
	"engines": {
		"node": ">=24"
	}
}
