{
	"name": "@ac-kit/format-css-color",
	"version": "0.1.0",
	"description": "Parse, serialise and evaluate the CSS <color> production.",
	"keywords": [
		"color",
		"color-mix",
		"css",
		"oklab",
		"parser"
	],
	"homepage": "https://anthochamp.github.io/node-essentials/api/format-css-color/",
	"bugs": {
		"url": "https://github.com/anthochamp/node-essentials/issues"
	},
	"license": "BSD-3-Clause",
	"author": "Anthony Champagne <dev@anthonychampagne.fr>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anthochamp/node-essentials.git",
		"directory": "packages/format-css-color"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./names/*": "./src/names/*.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"exports": {
			".": "./dist/index.js",
			"./names/*": "./dist/names/*.js"
		},
		"access": "public"
	},
	"scripts": {
		"compile": "tsc -p ./tsconfig.build.json -outDir dist",
		"compile:check": "tsc -noEmit -p ./tsconfig.json",
		"clean": "rimraf dist",
		"build": "yarn clean && yarn compile",
		"generate:names": "node --import tsx ./scripts/generate-names.ts",
		"test": "yarn run -T vitest run",
		"prepack": "yarn build"
	},
	"dependencies": {
		"@ac-kit/core": "workspace:^",
		"@ac-kit/math-color": "workspace:^",
		"@ac-kit/math-geometry": "workspace:^",
		"@ac-kit/math-scalar": "workspace:^",
		"@types/node": "catalog:"
	},
	"devDependencies": {
		"@ac-kit/format-po": "workspace:^",
		"@ac-kit/tsconfig": "workspace:*",
		"@ac-kit/typedoc-config": "workspace:*",
		"@ac-kit/vitest-config": "workspace:*",
		"@typescript/native": "catalog:fixed",
		"rimraf": "catalog:fixed",
		"tsx": "catalog:fixed",
		"typedoc": "catalog:fixed",
		"typescript": "catalog:fixed"
	},
	"engines": {
		"node": ">=24"
	}
}
