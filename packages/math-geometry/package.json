{
	"name": "@ac-kit/math-geometry",
	"version": "0.1.0",
	"description": "Computational geometry in 2D, 3D and 4D: shapes, coordinate systems, angles, and the predicates and constructions over them.",
	"keywords": [
		"2d",
		"3d",
		"computational-geometry",
		"geometry"
	],
	"homepage": "https://anthochamp.github.io/node-essentials/api/math-geometry/",
	"bugs": {
		"url": "https://github.com/anthochamp/node-essentials/issues"
	},
	"license": "BSD-3-Clause",
	"author": "Anthony Champagne <dev@anthonychampagne.fr>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anthochamp/node-essentials.git",
		"directory": "packages/math-geometry"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"exports": {
			".": "./dist/index.js"
		},
		"access": "public"
	},
	"scripts": {
		"compile": "tsc -p ./tsconfig.build.json -outDir dist",
		"compile:check": "tsc -noEmit -p ./tsconfig.json",
		"clean": "rimraf dist",
		"build": "yarn clean && yarn compile",
		"test": "yarn run -T vitest run",
		"prepack": "yarn build"
	},
	"dependencies": {
		"@ac-kit/core": "workspace:^",
		"@ac-kit/math-linear": "workspace:^",
		"@ac-kit/math-scalar": "workspace:^",
		"@types/web": "catalog:"
	},
	"devDependencies": {
		"@ac-kit/test-util": "workspace:*",
		"@ac-kit/tsconfig": "workspace:*",
		"@ac-kit/typedoc-config": "workspace:*",
		"@ac-kit/vitest-config": "workspace:*",
		"@typescript/native": "catalog:fixed",
		"rimraf": "catalog:fixed",
		"typedoc": "catalog:fixed",
		"typescript": "catalog:fixed",
		"vite": "catalog:fixed",
		"vitest": "catalog:fixed"
	},
	"engines": {
		"node": ">=24"
	}
}
