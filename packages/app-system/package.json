{
	"name": "@ac-kit/app-system",
	"version": "0.1.0",
	"description": "Process lifecycle helpers: PID files, process inspection, log rotation and command execution.",
	"keywords": [
		"log-rotation",
		"nodejs",
		"pidfile",
		"process",
		"system"
	],
	"homepage": "https://anthochamp.github.io/node-essentials/api/app-system/",
	"bugs": {
		"url": "https://github.com/anthochamp/node-essentials/issues"
	},
	"license": "BSD-3-Clause",
	"author": "Anthony Champagne <dev@anthonychampagne.fr>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anthochamp/node-essentials.git",
		"directory": "packages/app-system"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./src/index.ts",
	"publishConfig": {
		"main": "./dist/index.js",
		"access": "public"
	},
	"scripts": {
		"compile": "tsc -p ./tsconfig.build.json -outDir dist",
		"compile:check": "tsc -noEmit -p ./tsconfig.json",
		"clean": "rimraf dist",
		"build": "yarn clean && yarn compile",
		"test": "yarn run -T vitest run",
		"prepack": "yarn build"
	},
	"dependencies": {
		"@ac-kit/app-report": "workspace:^",
		"@ac-kit/app-terminal": "workspace:^",
		"@ac-kit/async": "workspace:^",
		"@ac-kit/core": "workspace:*",
		"@ac-kit/crypto-hash": "workspace:^",
		"@ac-kit/data": "workspace:^",
		"@ac-kit/format-ansi": "workspace:^",
		"@ac-kit/node": "workspace:*",
		"@types/node": "catalog:",
		"type-fest": "catalog:"
	},
	"devDependencies": {
		"@ac-kit/tsconfig": "workspace:*",
		"@ac-kit/typedoc-config": "workspace:*",
		"@ac-kit/vitest-config": "workspace:*",
		"@typescript/native": "catalog:fixed",
		"iconv-lite": "catalog:fixed",
		"rimraf": "catalog:fixed",
		"tsx": "catalog:fixed",
		"typedoc": "catalog:fixed",
		"typescript": "catalog:fixed"
	},
	"peerDependencies": {
		"iconv-lite": "*"
	},
	"peerDependenciesMeta": {
		"iconv-lite": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	}
}
