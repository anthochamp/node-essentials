{
	"name": "@ac-kit/oxlint-config",
	"version": "0.1.0",
	"description": "Shareable oxlint and oxfmt configurations.",
	"keywords": [
		"config",
		"formatter",
		"linter",
		"oxfmt",
		"oxlint"
	],
	"homepage": "https://github.com/anthochamp/node-essentials/tree/main/packages/oxlint-config#readme",
	"bugs": {
		"url": "https://github.com/anthochamp/node-essentials/issues"
	},
	"license": "BSD-3-Clause",
	"author": "Anthony Champagne <dev@anthonychampagne.fr>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anthochamp/node-essentials.git",
		"directory": "packages/oxlint-config"
	},
	"type": "module",
	"main": "./oxlintrc.js",
	"exports": {
		".": {
			"types": "./oxlint.d.ts",
			"default": "./oxlint.js"
		},
		"./oxfmt": {
			"types": "./oxfmt.d.ts",
			"default": "./oxfmt.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24"
	}
}
