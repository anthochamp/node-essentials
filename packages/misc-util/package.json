{
	"name": "@ac-essentials/misc-util",
	"version": "0.7.0",
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./chardet": "./src/3rdparty/chardet/chardet-charset-to-buffer-encoding.ts",
		"./editorconfig": "./src/3rdparty/editorconfig/editorconfig-charset-to-buffer-encoding.ts",
		"./flock": "./src/3rdparty/fs-ext/flock.ts",
		"./mime-db": "./src/3rdparty/mime-db/get-first-mime-type-file-extension.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"exports": {
			".": "./dist/index.js",
			"./chardet": "./dist/3rdparty/chardet/chardet-charset-to-buffer-encoding.js",
			"./editorconfig": "./dist/3rdparty/editorconfig/editorconfig-charset-to-buffer-encoding.js",
			"./flock": "./dist/3rdparty/fs-ext/flock.js",
			"./mime-db": "./dist/3rdparty/mime-db/get-first-mime-type-file-extension.js"
		},
		"access": "public"
	},
	"scripts": {
		"compile": "tsc -p ./tsconfig.build.json -outDir dist",
		"compile:check": "tsc -noEmit -p ./tsconfig.json",
		"clean": "rimraf dist",
		"build": "yarn clean && yarn compile",
		"test": "yarn run -T vitest run  --project $npm_package_name",
		"prepack": "yarn build"
	},
	"dependencies": {
		"@types/fs-ext": "^2.0.3",
		"@types/ini": "^4.1.1",
		"@types/node": "^24.5.2",
		"chardet": "^2.1.0",
		"content-disposition": "^3.0.0",
		"content-type": "^2.0.0",
		"editorconfig": "^3.0.1",
		"fs-ext": "^2.1.1",
		"iconv-lite": "^0.7.0",
		"ini": "^7.0.0",
		"json5": "^2.2.3",
		"jsonc-parser": "^3.3.1",
		"mime-db": "^1.54.0",
		"shallow-clone": "^3.0.1",
		"smol-toml": "^1.5.2",
		"type-fest": "^5.0.1",
		"yaml": "^2.8.1"
	},
	"devDependencies": {
		"@ac-essentials/tsconfig": "workspace:*",
		"@ac-essentials/typedoc-config": "workspace:*",
		"@types/content-disposition": "0.5.9",
		"@types/content-type": "2.0.0",
		"@types/mime-db": "1.43.6",
		"@types/shallow-clone": "3.0.2",
		"rimraf": "6.1.3",
		"typedoc": "0.28.20",
		"typescript": "7.0.2"
	}
