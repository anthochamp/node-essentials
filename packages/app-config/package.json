{
	"name": "@ac-kit/app-config",
	"version": "0.1.0",
	"description": "CLI configuration loading, built on cosmiconfig.",
	"keywords": [
		"cli",
		"config",
		"configuration",
		"cosmiconfig"
	],
	"homepage": "https://anthochamp.github.io/node-essentials/api/app-config/",
	"bugs": {
		"url": "https://github.com/anthochamp/node-essentials/issues"
	},
	"license": "BSD-3-Clause",
	"author": "Anthony Champagne <dev@anthonychampagne.fr>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anthochamp/node-essentials.git",
		"directory": "packages/app-config"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./src/index.ts",
	"publishConfig": {
		"main": "./dist/index.js",
		"access": "public"
	},
	"scripts": {
		"compile": "tsc -p ./tsconfig.build.json -outDir dist",
		"compile:check": "tsc -noEmit -p ./tsconfig.json",
		"clean": "rimraf dist",
		"build": "yarn clean && yarn compile",
		"test": "yarn run -T vitest run",
		"prepack": "yarn build"
	},
	"dependencies": {
		"@ac-kit/core": "workspace:*",
		"@ac-kit/format-editorconfig": "workspace:^",
		"@ac-kit/node": "workspace:*",
		"@types/node": "catalog:",
		"cosmiconfig": "catalog:",
		"type-fest": "catalog:"
	},
	"devDependencies": {
		"@ac-kit/tsconfig": "workspace:*",
		"@ac-kit/typedoc-config": "workspace:*",
		"@typescript/native": "catalog:fixed",
		"rimraf": "catalog:fixed",
		"typedoc": "catalog:fixed",
		"typescript": "catalog:fixed",
		"vitest-mock-extended": "catalog:fixed"
	},
	"engines": {
		"node": ">=24"
	}
}
