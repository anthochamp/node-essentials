{
	"name": "@ac-bench/cli",
	"version": "0.1.2",
	"description": "Command-line runner for @ac-bench benchmark suites: argument parsing, config-file loading and run resolution.",
	"keywords": [
		"benchmark",
		"cli",
		"measurement",
		"performance"
	],
	"homepage": "https://github.com/anthochamp/node-essentials/tree/main/bench/cli#readme",
	"bugs": {
		"url": "https://github.com/anthochamp/node-essentials/issues"
	},
	"license": "BSD-3-Clause",
	"author": "Anthony Champagne <dev@anthonychampagne.fr>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anthochamp/node-essentials.git",
		"directory": "bench/cli"
	},
	"bin": {
		"measure": "./bin/measure.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./src/config.ts",
	"exports": {
		".": "./src/config.ts",
		"./cli": "./src/main.ts"
	},
	"publishConfig": {
		"main": "./dist/config.js",
		"exports": {
			".": "./dist/config.js",
			"./cli": "./dist/main.js"
		},
		"access": "public"
	},
	"scripts": {
		"compile": "tsc -p ./tsconfig.build.json --outDir dist",
		"compile:check": "tsc -noEmit -p ./tsconfig.json",
		"clean": "rimraf dist",
		"build": "yarn clean && yarn compile",
		"test": "yarn run -T vitest run",
		"prepack": "yarn build"
	},
	"dependencies": {
		"@ac-bench/core": "workspace:^",
		"@ac-bench/lib": "workspace:^",
		"@ac-bench/reporter-csv": "workspace:^",
		"@ac-bench/reporter-json": "workspace:^",
		"@ac-bench/reporter-markdown": "workspace:^",
		"@ac-bench/reporter-table": "workspace:^",
		"@ac-kit/algo": "workspace:^",
		"@ac-kit/app-report": "workspace:^",
		"@ac-kit/app-system": "workspace:^",
		"@ac-kit/core": "workspace:^",
		"@ac-kit/node": "workspace:^",
		"commander": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@ac-kit/tsconfig": "workspace:*",
		"@ac-kit/typedoc-config": "workspace:*",
		"@ac-kit/vitest-config": "workspace:*",
		"@types/node": "catalog:fixed",
		"@typescript/native": "catalog:fixed",
		"rimraf": "catalog:fixed",
		"tsx": "catalog:fixed",
		"typedoc": "catalog:fixed",
		"typescript": "catalog:fixed",
		"vite": "catalog:fixed",
		"vitest": "catalog:fixed"
	},
	"engines": {
		"node": ">=24"
	}
}
