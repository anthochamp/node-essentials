{
	"name": "@ac-bench/core",
	"version": "0.1.1",
	"description": "Core contracts for @ac-bench: condition and case registration, the per-condition runner, the MeasureData wire shape, and the measure and reporter plugin interfaces.",
	"keywords": [
		"benchmark",
		"measurement",
		"performance",
		"plugin"
	],
	"homepage": "https://github.com/anthochamp/node-essentials/tree/main/bench/core#readme",
	"bugs": {
		"url": "https://github.com/anthochamp/node-essentials/issues"
	},
	"license": "BSD-3-Clause",
	"author": "Anthony Champagne <dev@anthonychampagne.fr>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anthochamp/node-essentials.git",
		"directory": "bench/core"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./runner": "./src/runner/index.ts",
		"./plugin": "./src/plugin/index.ts"
	},
	"publishConfig": {
		"exports": {
			"./runner": "./dist/runner/index.js",
			"./plugin": "./dist/plugin/index.js"
		},
		"access": "public"
	},
	"scripts": {
		"compile": "tsc -p ./tsconfig.build.json --outDir dist",
		"compile:check": "tsc -noEmit -p ./tsconfig.json",
		"clean": "rimraf dist",
		"build": "yarn clean && yarn compile",
		"test": "yarn run -T vitest run",
		"prepack": "yarn build"
	},
	"dependencies": {
		"@ac-kit/algo": "workspace:^",
		"@ac-kit/app-report": "workspace:^",
		"@ac-kit/app-terminal": "workspace:^",
		"@ac-kit/async": "workspace:^",
		"@ac-kit/core": "workspace:^",
		"@ac-kit/data": "workspace:^",
		"@ac-kit/math-random": "workspace:^",
		"@ac-kit/math-stats": "workspace:^",
		"@ac-kit/model-chart": "workspace:^",
		"@ac-kit/model-dataset": "workspace:^",
		"@types/web": "catalog:",
		"type-fest": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@ac-kit/tsconfig": "workspace:*",
		"@ac-kit/typedoc-config": "workspace:*",
		"@ac-kit/vitest-config": "workspace:*",
		"@types/node": "catalog:fixed",
		"@typescript/native": "catalog:fixed",
		"rimraf": "catalog:fixed",
		"typedoc": "catalog:fixed",
		"typescript": "catalog:fixed",
		"vite": "catalog:fixed",
		"vitest": "catalog:fixed"
	},
	"engines": {
		"node": ">=24"
	}
}
