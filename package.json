{
	"private": true,
	"workspaces": [
		"packages/*",
		"privatePackages/*",
		"types/*",
		"tools",
		"util/*",
		"examples/*"
	],
	"scripts": {
		"postinstall": "is-ci || lefthook install",
		"compile:check": "yarn workspaces foreach -Ap run compile:check",
		"lint": "oxlint && markdownlint-cli2",
		"lint:fix": "oxlint --fix && markdownlint-cli2 --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"clean": "yarn workspaces foreach -Ap run clean",
		"build-doc": "./scripts/yarn-workspaces-exec-if-dep.sh devDependencies typedoc typedoc",
		"build": "yarn workspaces foreach -Apt run build",
		"publish": "yarn workspaces foreach -A --no-private npm publish --tolerate-republish"
	},
	"devDependencies": {
		"@ac-essentials/markdownlint-cli2-config": "workspace:*",
		"@ac-essentials/oxlint-config": "workspace:*",
		"@vitest/coverage-v8": "4.1.11",
		"is-ci": "4.1.0",
		"lefthook": "2.1.10",
		"markdownlint-cli2": "0.23.2",
		"oxfmt": "0.64.0",
		"oxlint": "1.79.0",
		"oxlint-tsgolint": "7.0.2001",
		"vitest": "4.1.11"
	},
	"packageManager": "yarn@4.18.0"
}
